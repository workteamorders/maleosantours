# ====================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Upload file ini ke server dan rename menjadi .env
# ====================================================

# === DATABASE ===
# Dapatkan dari cPanel → MySQL Databases
# Format: mysql://USERNAME_DBUSER:PASSWORD@localhost:3306/USERNAME_DBNAME
DATABASE_URL="mysql://cpanel_user_dbuser:PASSWORD@localhost:3306/cpanel_user_maleosan"

# === APP ===
NODE_ENV=production
NEXTAUTH_SECRET=isi-dengan-random-string-panjang-minimal-32-karakter

# === OPTIONAL ===
# URL lengkap website di production
NEXT_PUBLIC_APP_URL=https://www.maleosantravel.com
