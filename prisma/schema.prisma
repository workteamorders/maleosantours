// Prisma Schema for Maleosan Travel CMS
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION
// ============================================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique(map: "admin_email_unique_idx")
  password  String   // Hashed with bcrypt
  name      String
  role      String   @default("admin")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin")
}

model Session {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique(map: "session_token_unique_idx")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("session")
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

// 1️⃣ INFO TRAVEL
model InfoTravel {
  id          String   @id @default(cuid())
  slug        String   @unique(map: "infotravel_slug_unique_idx")
  category    String   // 'destination', 'history', 'transport', 'food'
  
  // Multi-language content
  titleId     String
  titleEn     String
  titleZh     String
  titleZhCn   String
  
  descId      String   @db.Text
  descEn      String   @db.Text
  descZh      String   @db.Text
  descZhCn    String   @db.Text
  
  // Itinerary / List Content (JSON)
  itineraryId  String?  @db.Text
  itineraryEn  String?  @db.Text
  itineraryZh  String?  @db.Text
  itineraryZhCn String?  @db.Text
  
  images      String   @db.Text // JSON array of image URLs
  videoUrl    String?  @db.Text // YouTube/video embed URL
  icon        String?
  order       Int      @default(0)
  
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  
  // SEO
  metaTitleEn String?
  metaDescEn  String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("infotravel")
}

// 2️⃣ TOUR PACKAGES
model TourPackage {
  id           String   @id @default(cuid())
  slug         String   @unique(map: "tourpackage_slug_unique_idx")
  
  // Multi-language content
  nameId       String
  nameEn       String
  nameZh       String
  nameZhCn     String
  
  descId       String   @db.Text
  descEn       String   @db.Text
  descZh       String   @db.Text
  descZhCn     String   @db.Text
  
  // Tour details
  duration     String   // "1 Hari", "3 Hari 2 Malam", etc. (Indonesian/Base)
  durationEn   String?
  durationZh   String?
  durationZhCn String?
  
  type         String   // 'day-tour', 'multi-day', 'custom'
  price        Float?
  
  priceUnit    String?  // "per orang", "per grup" (Indonesian/Base)
  priceUnitEn  String?
  priceUnitZh  String?
  priceUnitZhCn String?
  
  priceTiers   String?  @db.Text // JSON: [{"label":"2 pax","price":"510.000,-/pax"},...]
  
  // Itinerary (JSON)
  itineraryId  String?  @db.Text
  itineraryEn  String?  @db.Text
  itineraryZh  String?  @db.Text
  itineraryZhCn String? @db.Text
  
  // Included/Excluded (JSON arrays)
  includedId   String?  @db.Text
  includedEn   String?  @db.Text
  includedZh   String?  @db.Text
  includedZhCn String?  @db.Text
  excludedId   String?  @db.Text
  excludedEn   String?  @db.Text
  excludedZh   String?  @db.Text
  excludedZhCn String?  @db.Text
  
  images       String   @db.Text // JSON array
  mainImage    String
  videoUrl     String?  @db.Text // Video URL (optional)
  
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  order        Int      @default(0)
  
  // SEO
  metaTitleEn  String?
  metaDescEn   String?  @db.Text
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  testimonials Testimonial[]

  @@map("tourpackage")
}

// 3️⃣ HOTELS
model Hotel {
  id           String   @id @default(cuid())
  slug         String   @unique(map: "hotel_slug_unique_idx")
  
  // Multi-language content
  nameId       String
  nameEn       String
  nameZh       String
  nameZhCn     String
  
  descId       String   @db.Text
  descEn       String   @db.Text
  descZh       String   @db.Text
  descZhCn     String   @db.Text
  
  category     String   // 'luxury', 'boutique', 'beach', 'budget', 'family', 'business'
  stars        Int      @default(3)
  location     String
  
  facilities   String   @db.Text // JSON array
  images       String   @db.Text // JSON array
  mainImage    String
  videoUrl     String?  @db.Text // Video URL (optional)
  
  bookingUrl   String?  @db.Text
  priceRange   String?  // "$$", "$$$", "$$$$"
  
  featured     Boolean  @default(false)
  active       Boolean  @default(true)
  order        Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hotel")
}

// 4️⃣ TRANSPORT
model Transport {
  id           String   @id @default(cuid())
  slug         String   @unique(map: "transport_slug_unique_idx")
  
  // Multi-language content
  nameId       String
  nameEn       String
  nameZh       String
  nameZhCn     String
  
  descId       String   @db.Text
  descEn       String   @db.Text
  descZh       String   @db.Text
  descZhCn     String   @db.Text
  
  type         String   // 'car', 'bus', 'airport', 'motor'
  capacity     Int?
  
  price        Float?
  priceUnit    String?  // "per day", "per trip"
  
  includesId   String?  @db.Text
  includesEn   String?  @db.Text
  
  images       String   @db.Text // JSON array
  mainImage    String
  videoUrl     String?  @db.Text // Video URL (optional)
  
  driverIncluded Boolean @default(true)
  available    Boolean  @default(true)
  order        Int      @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("transport")
}

// 5️⃣ TESTIMONIALS
model Testimonial {
  id            String   @id @default(cuid())
  
  customerName  String
  country       String
  rating        Int      @default(5)
  
  reviewId      String   @db.Text
  reviewEn      String   @db.Text
  reviewZh      String?  @db.Text
  reviewZhCn    String?  @db.Text 
  
  tourPackageId String?
  tourPackage   TourPackage? @relation(fields: [tourPackageId], references: [id], onDelete: SetNull)
  
  photo         String?
  order         Int      @default(0)
  approved      Boolean  @default(false)
  featured      Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("testimonial")
}

// 6️⃣ CONTACT & COMPANY INFO
model CompanyInfo {
  id            String   @id @default(cuid())
  
  phone         String
  phoneDisplay  String
  email         String
  addressId     String
  addressEn     String
  addressZh     String?  @db.Text
  addressZhCn   String?  @db.Text
  
  whatsapp      String?
  googleMaps    String?  @db.Text // Embed URL
  
  facebook      String?
  instagram     String?
  twitter       String?
  youtube       String?

  // Philosophy (Custom Text) - Indonesian (Main)
  philosophyTitleId    String?  @default("Filosofi Kami")
  philosophyTagline1Id String?  @default("Kami merancang perjalanan yang selaras dengan")
  philosophyTagline2Id String?  @default("irama alam.")

  // Philosophy - English
  philosophyTitleEn    String?  @default("Our Philosophy")
  philosophyTagline1En String?  @default("We curate journeys that breathe with the")
  philosophyTagline2En String?  @default("rhythm of nature.")

  // Philosophy - Chinese Simplified
  philosophyTitleZh    String?  @default("我们的理念")
  philosophyTagline1Zh String?  @default("我们打造与")
  philosophyTagline2Zh String?  @default("自然韵律共呼吸的旅程。")

  // Philosophy - Chinese Traditional
  philosophyTitleZhCn    String?  @default("我們的理念")
  philosophyTagline1ZhCn String?  @default("我們打造與")
  philosophyTagline2ZhCn String?  @default("自然韻律共呼吸的旅程。")
  
  updatedAt     DateTime @updatedAt

  @@map("companyinfo")
}

// 6️⃣ VISITOR COMMENTS (public, moderated)
model VisitorComment {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(80)
  content   String   @db.Text
  status    String   @default("pending") @db.VarChar(20) // 'pending', 'approved', 'rejected'
  ipHash    String?  @db.VarChar(64) // hashed IP for server-side rate limiting
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("visitorcomment")
}

model ContactSubmission {
  id         String   @id @default(cuid())
  
  name       String
  email      String
  subject    String
  message    String   @db.Text
  
  status     String   @default("new") // 'new', 'read', 'replied', 'archived'
  notes      String?  @db.Text 
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contactsubmission")
}

// 7️⃣ PAGE HEADERS (Editable header images per page)
model PageHeader {
  id        String   @id @default(cuid())
  pageKey   String   @unique(map: "pageheader_key_unique_idx")
  // Page keys: 'info-travel', 'paket-tour', 'hotels', 'transport', 'testimoni', 'kontak'
  image     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("pageheader")
}

// 8️⃣ MEDIA LIBRARY (Optional but useful)
model Media {
  id         String   @id @default(cuid())
  
  filename   String
  url        String
  type       String   // 'image', 'video', 'document'
  size       Int      // bytes
  mimeType   String
  
  alt        String?
  caption    String?
  
  createdAt  DateTime @default(now())

  @@map("media")
}

// 8️⃣ HOMEPAGE CONTENT (Editable sections)
model HomepageItem {
  id        String   @id @default(cuid())
  
  section   String   // 'hero', 'destination', 'journal'
  
  title     String?
  subtitle  String?  // category for destinations, date for journals
  desc      String?  @db.Text
  image     String   @db.Text
  link      String?
  rotation  Int      @default(0) // Image rotation in degrees (0, 90, 180, 270)
  
  order     Int      @default(0)
  active    Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepageitem")
}
